# CC — Career Craft Frontend Environment Variables
# Copy this to .env during local development if backend is not on port 5000.
# In production on Vercel/Netlify, set this to your deployed backend URL.

# Example for local development:
# VITE_API_URL=http://localhost:5000/api

# Example for production (Render backend):
# VITE_API_URL=https://your-career-craft-backend.onrender.com/api
