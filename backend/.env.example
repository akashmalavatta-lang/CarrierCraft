# CC — Career Craft Backend Environment Variables
# Copy this file to .env and fill in real values (never commit .env to git)

# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string-in-production

# JWT
JWT_SECRET_KEY=change-this-jwt-secret-to-something-random

# Database (SQLite for local dev, PostgreSQL URL for production)
DATABASE_URL=sqlite:///cc_careercraft.db

# File Upload
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

# Optional: Gemini AI Free Tier (https://aistudio.google.com/app/apikey)
# Leave blank to use local NLP-only mode (fully functional without this)
GEMINI_API_KEY=

# Optional: Adzuna Job Search API (https://developer.adzuna.com)
# Free tier: 250 calls/month — leave blank to use redirect-link mode
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
